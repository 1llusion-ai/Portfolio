---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/Home.astro';
import { global, identity } from '../../data/site';

const lang = 'zh';
const title = `${identity.name} · ${global.headline.zh}`;
const description = global.intro.zh;
---

<BaseLayout lang={lang} title={title} description={description} pathname={Astro.url.pathname}>
  <Home lang={lang} />
</BaseLayout>
