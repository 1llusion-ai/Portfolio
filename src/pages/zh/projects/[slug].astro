---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectPage from '../../../components/ProjectPage.astro';
import { projects, identity } from '../../../data/site';
import type { Project } from '../../../data/site';

export function getStaticPaths() {
  return projects.map((p: Project) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const lang = 'zh';
const title = `${project.title.zh} · ${identity.name}`;
const description = project.oneLiner.zh;
---

<BaseLayout lang={lang} title={title} description={description} pathname={Astro.url.pathname} ogType="article">
  <ProjectPage project={project} lang={lang} />
</BaseLayout>
