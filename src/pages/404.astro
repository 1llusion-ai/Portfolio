---
import BaseLayout from '../layouts/BaseLayout.astro';
import { identity, misc } from '../data/site';
import { pageLang, homePath } from '../lib/lang';

const lang = pageLang(Astro.url.pathname);
const t = {
  h1: misc.notFound.title[lang],
  p: misc.notFound.body[lang],
  home: misc.notFound.home[lang],
  en: misc.notFound.switchToOther[lang],
};
const title = `404 · ${identity.name}`;
---

<BaseLayout lang={lang} title={title} description={t.p} pathname={Astro.url.pathname} isNotFound>
  <section class="notfound">
    <div class="container">
      <div class="notfound-box">
        <p class="notfound-code">404</p>
        <h1>{t.h1}</h1>
        <p>{t.p}</p>
        <div class="contact-cta">
          <a class="btn btn--primary" href={homePath(lang)}>{t.home}</a>
          <a class="btn btn--ghost" href={lang === 'zh' ? `${import.meta.env.BASE_URL}en/` : `${import.meta.env.BASE_URL}zh/`}>
            {t.en}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
