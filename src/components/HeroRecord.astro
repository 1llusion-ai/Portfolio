---
import { projects, sections } from '../data/site';
import type { Lang } from '../data/site';
import { projectPath } from '../lib/lang';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<aside class="project-directory" aria-label={sections.work.title[lang]}>
  <div class="directory-heading"><span>SELECTED WORK</span><span>01 — 03</span></div>
  <p class="directory-title">{lang === 'zh' ? '三个切面，同一个问题。' : 'Three perspectives. One question.'}</p>
  <p class="directory-subtitle">{lang === 'zh' ? '如何让 LLM 系统可靠地完成任务？' : 'How can LLM systems complete tasks reliably?'}</p>
  {projects.map(project => <a class="directory-item" href={projectPath(lang, project.slug)}><span class="directory-index">{project.index}</span><div><span class="directory-domain">{project.domain[lang]}</span><strong>{project.title[lang]}</strong><p>{project.outcome?.[lang]}</p></div><span class="directory-arrow" aria-hidden="true">↗</span></a>)}
  <div class="directory-bottom"><span>DESIGN → BUILD → EVALUATE</span><span aria-hidden="true">✳</span></div>
</aside>
<style>
.project-directory{background:transparent;color:var(--ink);padding:1rem 1.2rem 1rem 0;position:relative;min-width:0;}
.directory-heading,.directory-bottom{display:flex;justify-content:space-between;gap:1rem;font:400 .65rem/1.7 var(--font-mono);letter-spacing:.1em;color:var(--ink-2);}
.directory-title{font-size:clamp(1.15rem,2vw,1.5rem);margin:2.3rem 0 .4rem;font-weight:500;}
.directory-subtitle{font-size:.8rem;color:var(--ink-2);margin-bottom:2rem;}
.directory-item{display:grid;grid-template-columns:1.5rem minmax(0,1fr) 1rem;gap:.7rem;padding:1.3rem 1rem;border:2px solid var(--ink);background:var(--butter);box-shadow:6px 6px 0 var(--ink);margin-bottom:1.3rem;transform:rotate(-1deg);color:inherit;text-decoration:none;transition:translate .2s,box-shadow .2s;}
.directory-item:hover,.directory-item:focus-visible{color:var(--ink);translate:0 -4px;box-shadow:9px 10px 0 var(--ink);}
.directory-item:nth-of-type(2){background:var(--violet);transform:translateX(.6rem) rotate(1deg);}
.directory-item:nth-of-type(3){background:var(--blue);transform:translateX(1.2rem) rotate(-1deg);}
.directory-index{font:.7rem/1.8 var(--font-mono);color:var(--ink);}
.directory-domain{font-size:.65rem;color:var(--ink);display:block;margin-bottom:.3rem;}
.directory-item strong{display:block;font-size:1rem;font-weight:500;line-height:1.55;}
.directory-item p{font-size:.7rem;color:var(--ink);line-height:1.8;margin:.5rem 0 0;}
.directory-arrow{color:var(--ink);}
.directory-bottom{border-top:2px solid var(--ink);padding-top:1rem;margin-top:.5rem;align-items:center;}
.directory-bottom span:last-child{font-size:1.8rem;line-height:1;}
@media(max-width:820px){.project-directory{padding-right:1.3rem;}.directory-title{margin-top:1rem;}}
@media(prefers-reduced-motion:reduce){.directory-item,.directory-item:nth-of-type(2),.directory-item:nth-of-type(3){transform:none;translate:none;}}
</style>
