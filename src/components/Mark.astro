---
// Original Evidence Ledger mark: paper tile, ruled baseline,
// cobalt registration ticks, acid-lime verified check.
// Color-agnostic: frame strokes follow `currentColor`.
---

<svg
  class="mark-svg"
  viewBox="0 0 64 64"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <rect width="64" height="64" rx="6" fill="var(--paper-2)" />
  <rect
    x="2"
    y="2"
    width="60"
    height="60"
    rx="5"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
  />
  <path d="M16 52 H48" stroke="currentColor" stroke-width="2" />
  <path
    d="M9 15 V9 H15"
    fill="none"
    stroke="var(--cobalt)"
    stroke-width="3"
    stroke-linecap="round"
  />
  <path
    d="M55 49 V55 H49"
    fill="none"
    stroke="var(--cobalt)"
    stroke-width="3"
    stroke-linecap="round"
  />
  <path
    d="M19 33 L28 42 L46 21"
    fill="none"
    stroke="var(--lime-deep)"
    stroke-width="6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
