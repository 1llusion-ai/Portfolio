---
import type { Lang } from '../data/site';
import { embeddingCase as copy, historicalScores } from '../data/embeddingCase';
import DiagramComparison from './diagrams/DiagramComparison.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
---
<section class="case-sec" id="problem">
  <h2 class="case-sec-title"><span class="idx">01</span>{copy.background.title[lang]}</h2>
  <div class="case-sec-body"><p>{copy.background.body[lang]}</p><div class="task-pair">{copy.background.tasks.map(t => <div><h3>{t.title[lang]}</h3><p>{t.body[lang]}</p></div>)}</div></div>
</section>
<section class="case-sec" id="mechanism">
  <h2 class="case-sec-title"><span class="idx">02</span>{copy.strategy.title[lang]}</h2>
  <div class="case-sec-body"><p>{copy.strategy.body[lang]}</p><h3>{zh ? '先选负样本来源' : 'Select the negative source'}</h3><p>{copy.strategy.negative[lang]}</p><h3>{zh ? '再定义正样本关系' : 'Then define positive relationships'}</h3><p>{copy.strategy.positive[lang]}</p></div>
  <figure class="strategy-figure"><figcaption>{copy.strategy.diagramTitle[lang]}</figcaption>
    <div class="strategy-root">{zh ? '用户请求 → 按意图选择匹配标准' : 'User request → Select matching criteria by intent'}</div>
    <div class="strategy-branches">{copy.strategy.branches.map(b => <div class="strategy-branch"><h3>{b.title[lang]}</h3><p class="example">{b.example[lang]}</p><ul><li class="positive">{b.positive[lang]}</li><li>{b.neutral[lang]}</li><li class="negative">{b.negative[lang]}</li></ul></div>)}</div>
    <p class="mining-note">{copy.strategy.mining[lang]}</p>
  </figure>
</section>
<section class="case-sec" id="evaluation">
  <h2 class="case-sec-title"><span class="idx">03</span>{copy.evaluation.title[lang]}</h2>
  <div class="case-sec-body"><p>{copy.evaluation.body[lang]}</p><ul class="checks">{copy.evaluation.checks.map(c => <li>{c[lang]}</li>)}</ul></div>
</section>
<section class="case-sec" id="validation">
  <h2 class="case-sec-title"><span class="idx">04</span>{copy.results.title[lang]}</h2>
  <div class="case-sec-body"><p>{copy.results.body[lang]}</p></div>
  <figure><figcaption>{copy.results.caption[lang]}</figcaption><DiagramComparison lang={lang} /></figure>
  <div class="case-sec-body results-detail"><p>{copy.results.interpretation[lang]}</p><h3>{copy.results.historicalTitle[lang]}</h3><p>{copy.results.historicalScope[lang]}</p>
    <div class="table-scroll" role="region" aria-label={copy.results.historicalTitle[lang]} tabindex="0"><table><caption>{zh ? '历史 V2 · Hit@1（%）' : 'Historical V2 · Hit@1 (%)'}</caption><thead><tr>{copy.results.historicalHeaders.map(h => <th scope="col">{h[lang]}</th>)}</tr></thead><tbody>{historicalScores.map(r => <tr><th scope="row">{r.name[lang]}</th><td>{r.full}</td><td>{r.query}</td></tr>)}</tbody></table></div>
    <p class="scope-note">{copy.results.limitation[lang]}</p>
  </div>
</section>
<section class="case-sec" id="tradeoffs">
  <h2 class="case-sec-title"><span class="idx">05</span>{copy.analysis.title[lang]}</h2>
  <div class="case-sec-body">{copy.analysis.points.map(p => <div class="analysis-point"><h3>{p.title[lang]}</h3><p>{p.body[lang]}</p></div>)}<p class="next-note">{copy.analysis.next[lang]}</p></div>
</section>
<style>
  h3 { font-family: var(--font-sans); font-size: 1.05rem; font-weight: 600; line-height: 1.6; margin: 1.5rem 0 .65rem; }
  .task-pair { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .task-pair > div { border-top: 2px solid var(--cobalt); }
  .task-pair h3 { margin-top: .8rem; }
  .task-pair p { font-size: .9rem; }
  figure { margin: 1.25rem 0; min-width: 0; grid-column: 1 / -1; }
  figcaption { font-weight: 600; font-size: .95rem; margin-bottom: 1.25rem; }
  .strategy-figure { padding: clamp(1rem,3vw,2rem); background: var(--paper-2); border: 1px solid var(--rule); }
  .strategy-root { padding: 1rem; background: var(--ink); color: var(--paper); text-align: center; font-size: .95rem; }
  .strategy-branches { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.5rem; }
  .strategy-branch { position: relative; padding: 1.25rem; margin-top: 1.5rem; background: var(--paper); border: 1px solid var(--rule-strong); border-top: 3px solid var(--cobalt); }
  .strategy-branch::before { content: ''; position: absolute; bottom: 100%; left: 50%; height: 1.5rem; border-left: 2px solid var(--cobalt); }
  .strategy-branch h3 { margin-top: 0; }
  .example { color: var(--ink-2); font-size: .9rem; padding-bottom: .8rem; border-bottom: 1px solid var(--rule); }
  .strategy-branch ul { display: grid; gap: .75rem; font-size: .875rem; line-height: 1.8; }
  .strategy-branch li { padding-left: .8rem; border-left: 2px solid var(--rule-strong); }
  .strategy-branch .positive { border-color: var(--lime-deep); }
  .strategy-branch .negative { border-color: var(--cobalt); }
  .mining-note { margin: 1.25rem 0 0; font-size: .85rem; color: var(--ink-2); line-height: 1.85; }
  .checks { padding-left: 1.2rem; list-style: disc; }
  .checks li { margin-bottom: .75rem; color: var(--ink-2); }
  .table-scroll { overflow-x: auto; margin: 1.5rem 0; }
  table { width: 100%; border-collapse: collapse; font-size: .875rem; font-variant-numeric: tabular-nums; }
  caption { text-align: left; font-size: .8rem; color: var(--ink-2); padding-bottom: .6rem; }
  th, td { text-align: right; padding: .8rem .6rem; border-bottom: 1px solid var(--rule); }
  th { font-weight: 500; } th:first-child { text-align: left; } td { white-space: nowrap; }
  thead { background: var(--paper-2); }
  .scope-note, .next-note { border-left: 3px solid var(--cobalt); padding-left: 1rem; margin-top: 1.5rem; }
  .scope-note { font-size: .875rem; }
  .analysis-point + .analysis-point { border-top: 1px solid var(--rule); margin-top: 1.5rem; }
  .analysis-point:first-child h3 { margin-top: 0; }
  @media (min-width:720px) { .results-detail { grid-column: 2; } }
  @media (max-width:600px) { .task-pair, .strategy-branches { grid-template-columns: 1fr; } .strategy-branches { gap: 0; } }
</style>
