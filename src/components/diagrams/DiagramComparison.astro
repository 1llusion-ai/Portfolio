---
import type { Lang } from '../../data/site';
import { embeddingScores } from '../../data/embeddingCase';
interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const panels = [
  { key: 'functionHit' as const, title: zh ? '功能点过滤' : 'Function filtering', scope: zh ? '42,100 条可评分记录' : '42,100 scorable records' },
  { key: 'strictHit' as const, title: zh ? '严格 few-shot' : 'Strict few-shot', scope: zh ? '41,443 条可评分记录' : '41,443 scorable records' },
];
---
<div class="comparison-panels">
  {panels.map(panel => <div class="comparison-panel"><h3>{panel.title}</h3><p>{panel.scope}</p><div class="axis" aria-hidden="true"><span>0%</span><span>50%</span><span>100%</span></div><ul>{embeddingScores.map(row => <li><div class="bar-label"><span>{row.name}</span><strong>{row[panel.key].toFixed(3)}%</strong></div><div class="track" aria-hidden="true"><span class:list={['bar', { hybrid: row.name === 'Hybrid' }]} style={`width:${row[panel.key]}%`}></span></div></li>)}</ul></div>)}
</div>
<style>
  .comparison-panels { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.5rem; }
  .comparison-panel { padding: clamp(1rem,3vw,1.75rem); border: 1px solid var(--rule); background: var(--paper-2); }
  h3 { font: 600 1.05rem/1.6 var(--font-sans); margin: 0 0 .35rem; }
  p { font-size: .8rem; color: var(--ink-2); margin-bottom: 1.25rem; }
  .axis { display: flex; justify-content: space-between; font-size: .7rem; color: var(--ink-3); margin-bottom: .75rem; }
  ul { display: grid; gap: 1rem; }
  .bar-label { display: flex; justify-content: space-between; gap: .5rem; font-size: .875rem; font-variant-numeric: tabular-nums; margin-bottom: .4rem; }
  strong { font-weight: 600; }
  .track { height: .7rem; background: var(--paper-3); }
  .bar { display: block; height: 100%; background: var(--ink-3); }
  .bar.hybrid { background: var(--cobalt); }
  @media (max-width:600px) { .comparison-panels { grid-template-columns: 1fr; } }
</style>
