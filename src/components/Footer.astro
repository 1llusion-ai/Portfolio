---
import { identity, cta } from '../data/site';
import type { Lang } from '../data/site';
import { homePath } from '../lib/lang';
interface Props { lang: Lang; pathname: string; isNotFound?: boolean }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="personal-footer">
  <div class="container footer-line">
    <a class="personal-signature" href={homePath(lang)}>{lang === 'zh' ? '肖凡' : 'XiaoFan'}<span>© {year}</span></a>
    <div class="personal-links"><a href={identity.github} target="_blank" rel="noopener">GitHub ↗</a><a href={`mailto:${identity.email}`}>{identity.email}</a></div>
    <a class="back-top" href="#">{cta.backToTop[lang]} ↑</a>
  </div>
</footer>
<style>
.personal-footer{border-top:1px solid var(--rule);padding:2rem 0;background:transparent;}
.footer-line{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;}
.personal-signature{display:flex;align-items:baseline;gap:1rem;font-size:1rem;font-weight:500;color:var(--ink);text-decoration:none;}
.personal-signature span{font-size:.75rem;font-weight:400;color:var(--ink-3);}
.personal-links{display:flex;flex-wrap:wrap;gap:1.5rem;}
.personal-links a,.back-top{font-size:.8rem;color:var(--ink-2);text-decoration:none;}
a:hover{text-decoration:underline;}
@media(max-width:600px){.footer-line{align-items:flex-start;}.personal-links{width:100%;order:3;gap:.8rem 1.3rem;}.back-top{margin-left:auto;}}
</style>
