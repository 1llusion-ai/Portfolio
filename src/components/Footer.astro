---
import { identity, global, safety, nav, cta } from '../data/site';
import type { Lang } from '../data/site';
import { homePath, switchPath } from '../lib/lang';
import Mark from './Mark.astro';

interface Props {
  lang: Lang;
  pathname: string;
  /** On the 404 page, the language switch resolves to the other locale's home. */
  isNotFound?: boolean;
}
const { lang, pathname, isNotFound = false } = Astro.props;
const other = lang === 'zh' ? 'en' : 'zh';
const switchHref = isNotFound ? homePath(other) : switchPath(pathname, other);
const otherLabel = lang === 'zh' ? 'English' : '中文';
const backLabel = cta.backToTop[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <p class="footer-brand">
          <span class="footer-brand-mark" aria-hidden="true"><Mark /></span>
          Evidence Ledger
        </p>
        <p class="footer-avail">{global.availability[lang]}</p>
        <p class="footer-disclosure">{safety.disclosure[lang]}</p>
      </div>
      <div class="footer-links">
        <a href={identity.github} target="_blank" rel="noopener">
          GitHub ↗ <span class="mono">/{identity.github.split('/').pop()}</span>
        </a>
        <a href={`mailto:${identity.email}`}>{identity.email}</a>
        <a href={switchHref}>{otherLabel} / {other === 'en' ? 'EN' : '中'}</a>
      </div>
    </div>
    <div class="footer-meta">
      <span>© {year} {identity.name} · Evidence Ledger</span>
      <span>{nav.brand}</span>
      <a href={homePath(lang) + '#'} style="color:inherit">{backLabel} ↑</a>
    </div>
  </div>
</footer>
