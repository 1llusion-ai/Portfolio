---
import { projects, cta, safety, detailLabels, sanitizedNote } from '../data/site';
import type { Lang, Project } from '../data/site';
import { anchor, projectPath } from '../lib/lang';
import DiagramWorkflow from './diagrams/DiagramWorkflow.astro';
import DiagramMemory from './diagrams/DiagramMemory.astro';
import DiagramFaultTree from './diagrams/DiagramFaultTree.astro';
import DiagramComparison from './diagrams/DiagramComparison.astro';
import DiagramLoop from './diagrams/DiagramLoop.astro';
import AgentCaseBody from './AgentCaseBody.astro';
import TeachingCaseBody from './TeachingCaseBody.astro';
import { teachingCase } from '../data/teachingCase';
import EmbeddingCaseBody from './EmbeddingCaseBody.astro';
import { embeddingCase } from '../data/embeddingCase';
import { agentCase } from '../data/agentCase';

interface Props {
  project: Project;
  lang: Lang;
}
const { project, lang } = Astro.props;
const pos = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(pos + 1) % projects.length];
const d = project.detail;
const L = detailLabels;
const idx = (n: number) => String(n).padStart(2, '0');
const nextLabel = cta.nextCase[lang];
const isAgentCase = project.slug === 'agentic-model-iteration';
const isTeachingCase = project.slug === 'evidence-grounded-learning-agent';
const isEmbeddingCase = project.slug === 'task-aware-embedding-finetuning';
---

<article class:list={["case", { "case--edited": isAgentCase || isEmbeddingCase || isTeachingCase }]}>
  <div class:list={['container', 'case-grid', { 'case-grid--agent': isAgentCase || isEmbeddingCase || isTeachingCase }]}>
    <a class="case-back" href={anchor('work', lang)}>← {cta.backToWork[lang]}</a>

    <header class={`case-head case-head--${project.index}`}>
      <span class="case-head-mark" aria-hidden="true">{project.index}</span>
      <p class="eyebrow mono">{L.case[lang]} {project.index} · {project.domain[lang]}</p>
      <h1 class="case-title">{project.title[lang]}</h1>
      <p class="case-one">{project.oneLiner[lang]}</p>
      <ul class="case-tags">
        {project.tags[lang].map((t) => <li>{t}</li>)}
      </ul>
      {isAgentCase && <div class="agent-role"><p class="eyebrow mono">{agentCase.roleLabel[lang]}</p><p>{agentCase.role[lang]}</p></div>}
      {isEmbeddingCase && <div class="embedding-role"><p class="eyebrow">{lang === 'zh' ? '我的职责' : 'My role'}</p><p>{embeddingCase.role[lang]}</p></div>}
      {isTeachingCase && <div class="embedding-role"><p class="eyebrow">{lang === 'zh' ? '我的职责' : 'My role'}</p><p>{teachingCase.role[lang]}</p></div>}
    </header>

    {isAgentCase ? <AgentCaseBody lang={lang} /> : isEmbeddingCase ? <EmbeddingCaseBody lang={lang} /> : isTeachingCase ? <TeachingCaseBody lang={lang} /> : <>
    <section class="case-sec" id="problem">
      <h2 class="case-sec-title"><span class="idx">{idx(1)}</span>{L.problem[lang]}</h2>
      <div class="case-sec-body"><p>{d.problem[lang]}</p></div>
    </section>

    <section class="case-sec" id="role">
      <h2 class="case-sec-title"><span class="idx">{idx(2)}</span>{L.role[lang]}</h2>
      <div class="case-sec-body"><p class="case-role">{d.role[lang]}</p></div>
    </section>

    <section class="case-sec case-sec--mechanism" id="mechanism">
      <h2 class="case-sec-title"><span class="idx">{idx(3)}</span>{L.mechanism[lang]}</h2>
      <div class="case-sec-body">
        <p>{d.mechanism[lang]}</p>

        {project.diagram === 'workflow' && (
          <DiagramWorkflow lang={lang} steps={project.steps[lang]} />
        )}
        {project.diagram === 'loop' && (
          <DiagramLoop lang={lang} steps={project.steps[lang]} />
        )}
        {project.diagram === 'tree' && project.tree && (
          <DiagramFaultTree
            lang={lang}
            symptom={project.tree.symptom[lang]}
            hypotheses={project.tree.hypotheses[lang]}
            verify={project.tree.verify[lang]}
            repair={project.tree.repair[lang]}
            regression={project.tree.regression[lang]}
          />
        )}
        {project.diagram === 'comparison' && <DiagramComparison lang={lang} />}
        {project.diagram2 === 'memory' && project.memory && (
          <DiagramMemory lang={lang} memory={project.memory} />
        )}

        <p class="diagram-caption">{detailLabels.diagramCaption[lang]}</p>
      </div>
    </section>

    <section class="case-sec" id="validation">
      <h2 class="case-sec-title"><span class="idx">{idx(4)}</span>{L.validation[lang]}</h2>
      <div class="case-sec-body">
        <p>{d.validation[lang]}</p>
      </div>
    </section>

    <section class="case-sec" id="tradeoffs">
      <h2 class="case-sec-title"><span class="idx">{idx(5)}</span>{L.tradeoffs[lang]}</h2>
      <div class="case-sec-body"><p>{d.tradeoffs[lang]}</p></div>
    </section>

    <section class="case-sec" id="boundary">
      <h2 class="case-sec-title"><span class="idx">{idx(6)}</span>{L.boundary[lang]}</h2>
      <div class="case-sec-body">
        <p>{d.boundary[lang]}</p>
        {project.source && (
          <p>
            <a class="btn btn--ghost" href={project.source} target="_blank" rel="noopener">
              {cta.source[lang]} ↗
            </a>
          </p>
        )}
      </div>
    </section>

    <aside class="disclosure" role="note">
      <p>{safety.disclosure[lang]}</p>
      <p class="disclosure-detail">{sanitizedNote[lang]}</p>
    </aside>
    </>}

    <nav class="case-next" aria-label={nextLabel}>
      <a href={projectPath(lang, next.slug)}>
        <span class="kicker">{cta.nextCase[lang]} · {next.index}</span>
        <span class="t">{next.title[lang]}</span>
        <span class="arr" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</article>

<style>
  .case-grid--agent { max-width: 1140px; }
  .agent-role { max-width: 760px; margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,.25); }
  .agent-role .eyebrow { margin-bottom: .5rem; }
  .agent-role > p:last-child { font-size: var(--text-sm); line-height: 1.85; color: var(--ink-2); }
  .case-head--02 .case-title { max-width: 24ch; }
  .embedding-role { max-width: 760px; margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid currentColor; }
  .embedding-role .eyebrow { margin-bottom: .5rem; }
  .embedding-role > p { font-size: var(--text-sm); line-height: 1.85; }
  .embedding-role .embedding-status { margin: 1rem 0 0; font-size: .8rem; font-weight: 500; }
</style>
