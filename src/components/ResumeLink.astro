---
import type { Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<a class="resume-download" href={`${import.meta.env.BASE_URL}downloads/xiaofan-resume.pdf`} download="秋招_肖凡.pdf">{lang === 'zh' ? '简历' : 'CV'} <span aria-hidden="true">↓</span></a>
<style>
.resume-download{display:inline-flex;align-items:center;gap:.6rem;color:var(--ink);text-decoration:none;border:0;background:transparent;box-shadow:none;padding:.7rem 0;min-height:44px;font-size:.85rem;white-space:nowrap;}.resume-download span{font:400 .65rem var(--font-mono);}.resume-download:hover{color:var(--cobalt);}
:global(.closing) .resume-download{border:0;background:transparent;box-shadow:none;color:var(--paper);}
</style>
